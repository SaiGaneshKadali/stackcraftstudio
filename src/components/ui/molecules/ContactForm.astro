---
import Heading from "@components/ui/atoms/Heading.astro";
import Text from "@components/ui/atoms/Text.astro";
import Input from "@components/ui/atoms/Input.astro";
import Textarea from "@components/ui/atoms/Textarea.astro";
import Icon from "@components/ui/atoms/Icon.astro";
import FormStatus from "@components/ui/patterns/FormStatus.astro";
import formMessages from "@data/global/form-messages.json";

type ContactField = {
  name: string;
  label: string;
  type?: "text" | "email" | "tel" | "number" | "url" | "password" | "date" | "textarea" | "select" | "checkbox";
  required?: boolean;
  placeholder?: string;
  rows?: number;
  autoComplete?: string;
  options?: { value: string; label: string }[];
};

interface Props {
  formId: string;
  fieldIdPrefix: string;
  fields: ContactField[];
  heading?: string;
  subheading?: string;
  buttonLabel?: string;
  submitLabel?: string;
  submittingLabel?: string;
  resetLabel?: string;
  successMessage?: string;
  errorMessage?: string;
  handoffMessage?: string;
  endpoint?: string;
  accessKey?: string;
  mailtoEmail?: string;
  whatsappNumber?: string;
  whatsappLabel?: string;
  whatsappButtonLabel?: string;
  emailButtonLabel?: string;
  privacyUrl?: string;
  showHeader?: boolean;
  includeRodoConsent?: boolean;
  class?: string;
}

const {
  formId = "cf-form",
  fieldIdPrefix = "cf",
  fields = [],
  heading = "",
  subheading,
  buttonLabel: buttonLabelProp = "",
  submitLabel: submitLabelProp = "",
  submittingLabel: submittingLabelProp = "",
  resetLabel: resetLabelProp = "",
  successMessage: successMessageProp = "",
  errorMessage: errorMessageProp = "",
  handoffMessage: handoffMessageProp = "",
  endpoint = "/send-form.php",
  accessKey = "",
  mailtoEmail = "",
  whatsappNumber = "",
  whatsappLabel = "",
  whatsappButtonLabel = "",
  emailButtonLabel = "",
  privacyUrl,
  showHeader = true,
  includeRodoConsent = true,
  class: className,
} = Astro.props as Props;

const submitLabel = submitLabelProp || buttonLabelProp || formMessages.submitLabel || "";
const submittingLabel = submittingLabelProp || formMessages.submittingLabel || "";
const resetLabel = resetLabelProp || formMessages.resetLabel || "";
const successMessage = successMessageProp || formMessages.successMessage || "";
const errorMessage = errorMessageProp || formMessages.errorMessage || "";
const handoffMessage = handoffMessageProp || formMessages.handoffMessage || successMessage;
const resetHover = formMessages.resetHover || "";
const submitHover = formMessages.submitHover || submitLabel;
const privacyNote = formMessages.privacyNote || "";
const privacyLinkLabel = formMessages.privacyLinkLabel || "";
const privacyHref = formMessages.privacyHref || privacyUrl || "/privacy-policy/";

const privacyLinkPattern = new RegExp(privacyLinkLabel.replace(/[.*+?^${}()|[\]\\]/g, "\\$&"), "i");
const [privacyPrefix = privacyNote, privacySuffix = ""] = privacyNote.split(privacyLinkPattern);

const defaultFields = (formMessages.defaultFields ?? []) as ContactField[];
const allFields = fields.length > 0 ? fields : defaultFields;
const gridFields: ContactField[] = allFields.slice(0, 2);
const restFields: ContactField[] = allFields.slice(2);

const whatsappDigits = whatsappNumber.replace(/\D/g, "");
const whatsappDirectHref = whatsappDigits
  ? `https://wa.me/${whatsappDigits}?text=${encodeURIComponent("Hi StackCraft Studio, I'd like to discuss a website project.")}`
  : "";

const toInputType = (field: ContactField): "text" | "email" | "tel" | "number" | "url" | "password" | "date" =>
  field.type === "select" || field.type === "textarea" || field.type === "checkbox"
    ? "text"
    : (field.type || "text");
---

<div class:list={["space-y-6", className]}>
  {
    showHeader && (
      <div class="space-y-2">
        <Heading tag="h2" variant="section-title" class="text-brand-dark">
          {heading || formMessages.heading}
        </Heading>
        {
          subheading && (
            <Text variant="lead" class="text-brand-dark/70">
              {subheading}
            </Text>
          )
        }
      </div>
    )
  }

  <form
    id={formId}
    action={endpoint || "/send-form.php"}
    method="POST"
    class="space-y-5 rounded-3xl border border-brand-dark/10 bg-surface p-6 shadow-sm sm:p-8"
    data-contact-form
    data-endpoint={endpoint || "/send-form.php"}
    data-form-transport={accessKey || (endpoint && endpoint.startsWith("http")) ? "json" : "form"}
    data-mailto-email={mailtoEmail}
    data-whatsapp-number={whatsappDigits}
    data-submit-label={submitLabel}
    data-submitting-label={submittingLabel}
    data-success-message={successMessage}
    data-error-message={errorMessage}
    data-form-msg-original={submitLabel}
    data-form-msg-loading={submittingLabel}
    data-form-msg-loading-title={formMessages.loadingTitle}
    data-form-msg-success-title={formMessages.successTitle}
    data-form-msg-error-title={formMessages.errorTitle}
    data-form-msg-success-retry={resetLabel}
    data-form-msg-error-retry={formMessages.retryLabel}
    data-form-msg-success={successMessage}
    data-form-msg-handoff={handoffMessage}
    data-form-msg-error={errorMessage}
    data-form-msg-loading-status={formMessages.loadingMessage}
    data-form-msg-network-error={formMessages.networkError}
    data-form-msg-invalid-response={formMessages.invalidResponse}
  >
    {accessKey && <input type="hidden" name="access_key" value={accessKey} />}

    <div data-form-feedback-stack class="ui-form-feedback-stack space-y-3" aria-live="polite">
      <div data-form-feedback="loading" hidden tabindex="-1">
        <FormStatus type="loading" title={formMessages.loadingTitle} description={formMessages.loadingMessage} />
      </div>
      <div data-form-feedback="success" hidden tabindex="-1">
        <FormStatus type="success" title={formMessages.successTitle} description={successMessage} />
        <div data-form-direct-actions hidden class="mt-3 flex flex-wrap gap-3">
          {whatsappDigits && (
            <a
              href={whatsappDirectHref}
              target="_blank"
              rel="noopener noreferrer"
              data-form-whatsapp-link
              class="inline-flex min-h-11 items-center gap-2 rounded-full bg-brand-dark px-5 py-2.5 text-sm font-semibold text-brand-light transition-colors hover:bg-brand-accent hover:text-brand-dark"
            >
              <Icon name="whatsapp-logo" class="text-base" />
              <span>{whatsappButtonLabel || formMessages.whatsappSendLabel}</span>
            </a>
          )}
          {mailtoEmail && (
            <a
              href={`mailto:${mailtoEmail}`}
              data-form-mailto-link
              class="inline-flex min-h-11 items-center gap-2 rounded-full border border-brand-dark/20 bg-surface px-5 py-2.5 text-sm font-semibold text-brand-dark transition-colors hover:border-brand-accent hover:text-brand-dark"
            >
              <Icon name="envelope" class="text-base" />
              <span>{emailButtonLabel || formMessages.emailSendLabel}</span>
            </a>
          )}
        </div>
      </div>
      <div data-form-feedback="error" hidden tabindex="-1">
        <FormStatus type="error" title={formMessages.errorTitle} description={errorMessage} />
      </div>
    </div>

    <div data-form-feedback="reset" hidden class="mt-4 text-center">
      <button type="button" data-form-reset class="ui-button ui-button-primary ui-type-cta-label font-semibold text-sm sm:text-base h-12 px-8">
        <span class="ui-button-text-wrap">
          <span class="ui-button-text-default">{resetLabel}</span>
          <span class="ui-button-text-hover">{resetHover}</span>
        </span>
      </button>
    </div>

    <div class="grid gap-5 sm:grid-cols-2" data-form-fields>
      {gridFields.map((field) => (
        <div>
          <Text tag="label" variant="accent-label" class="ui-form-label" for={`${fieldIdPrefix}-${field.name}`}>
            {field.label}
          </Text>
          <Input
            id={`${fieldIdPrefix}-${field.name}`}
            name={field.name}
            type={toInputType(field)}
            placeholder={field.placeholder || field.label}
            required={field.required}
            autocomplete={field.autoComplete}
          />
        </div>
      ))}
    </div>

    <div class="space-y-5 mt-5" data-form-fields>
      {restFields.map((field) => (
        <div>
          <Text tag="label" variant="accent-label" class="ui-form-label" for={`${fieldIdPrefix}-${field.name}`}>
            {field.label}
          </Text>
          {
            field.type === "textarea" ? (
              <Textarea
                id={`${fieldIdPrefix}-${field.name}`}
                name={field.name}
                placeholder={field.placeholder || field.label}
                required={field.required}
                rows={field.rows || 5}
              />
            ) : field.type === "select" && field.options ? (
              <div class="relative">
                <select
                  id={`${fieldIdPrefix}-${field.name}`}
                  name={field.name}
                  required={field.required}
                  class="ui-form-input w-full appearance-none pr-10"
                >
                  <option value="" selected>
                    {field.placeholder || field.label}
                  </option>
                  {field.options.map((opt) => (
                    <option value={opt.value}>{opt.label}</option>
                  ))}
                </select>
                <div class="pointer-events-none absolute inset-y-0 right-0 flex items-center pr-3">
                  <Icon name="caret-down" class="text-brand-dark/40" />
                </div>
              </div>
            ) : field.type === "checkbox" ? (
              <label class="ui-form-checkbox-container">
                <input
                  type="checkbox"
                  id={`${fieldIdPrefix}-${field.name}`}
                  name={field.name}
                  required={field.required}
                  class="ui-form-checkbox"
                />
                <span class="ui-form-checkbox-icon">
                  <Icon name="check" class="w-4 h-4 text-white" />
                </span>
                <Text tag="span" variant="body" class="text-sm text-brand-dark/70">
                  {field.label}
                </Text>
              </label>
            ) : (
              <Input
                id={`${fieldIdPrefix}-${field.name}`}
                name={field.name}
                type={toInputType(field)}
                placeholder={field.placeholder || field.label}
                required={field.required}
                autocomplete={field.autoComplete}
              />
            )
          }
        </div>
      ))}
    </div>

    <div style="display:none" aria-hidden="true">
      <input type="text" name="website" tabindex="-1" autocomplete="off" />
    </div>

    {
      includeRodoConsent && (
        <label class="ui-form-checkbox-container">
          <input type="checkbox" name="rodo" required class="ui-form-checkbox" />
          <span class="ui-form-checkbox-icon">
            <Icon name="check" class="w-4 h-4 text-white" />
          </span>
          <Text tag="span" variant="body" class="text-sm text-brand-dark/70">
            {formMessages.rodoConsent}
          </Text>
        </label>
      )
    }

    <div class="mt-5 flex flex-col gap-3 sm:flex-row">
      <button type="submit" class="ui-button ui-button-primary ui-type-cta-label font-semibold text-sm sm:text-base h-12 flex-1 px-6">
        <span class="ui-button-text-wrap">
          <span class="ui-button-text-default">{submitLabel}</span>
          <span class="ui-button-text-hover">{submitHover}</span>
        </span>
      </button>
      {whatsappDirectHref && (
        <a
          href={whatsappDirectHref}
          target="_blank"
          rel="noopener noreferrer"
          class="ui-button ui-button-outline ui-type-cta-label font-semibold text-sm sm:text-base h-12 px-6 inline-flex items-center justify-center gap-2"
        >
          <Icon name="whatsapp-logo" class="text-lg" />
          <span>{whatsappLabel || formMessages.whatsappQuickLabel}</span>
        </a>
      )}
    </div>

    <Text variant="disclaimer" class="text-xs text-center text-brand-dark/50 mt-3">
      {privacyPrefix.replace(/\{label\}/g, submitLabel)} <a href={privacyHref} class="underline hover:text-brand-primary">{privacyLinkLabel}</a>{privacySuffix}
    </Text>
  </form>
</div>

<style>
  form.is-submitted > .ui-form-feedback-stack {
    display: block;
  }
</style>
