---
import NavStyles from "./shared/NavStyles.astro";
import Centered from "./layouts/Centered.astro";
import Floating from "./layouts/Floating.astro";
import Local from "./layouts/Local.astro";
import Plain from "./layouts/Plain.astro";
import type { NavTheme } from "./shared/nav-theme-classes";
import type { StudioLocale } from "@utils/stackcraftstudio-i18n";

export type NavbarLayout = "centered" | "floating" | "local" | "plain";

interface Props {
	layout?: NavbarLayout;
	theme?: NavTheme;
	locale?: StudioLocale;
}

const { layout = "centered", theme = "transparent", locale = "en" } = Astro.props;

const layouts = {
	centered: Centered,
	floating: Floating,
	local: Local,
	plain: Plain,
} as const;

const Selected = layouts[layout] ?? Centered;
---

<NavStyles />
<Selected theme={theme} locale={locale} />

