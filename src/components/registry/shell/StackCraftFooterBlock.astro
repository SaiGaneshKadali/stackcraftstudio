---
import Text from "@components/ui/atoms/Text.astro";
import Button from "@components/ui/atoms/Button.astro";
import company from "@data/global/company.json";
import { getStudioCopy, getStudioNavigationPath, type StudioLocale } from "@utils/stackcraftstudio-i18n";
import { getEnabledSocialLinks } from "@utils/socials";

interface Props {
  locale?: StudioLocale;
}

const { locale = "en" } = Astro.props as Props;
const copy = getStudioCopy(locale).footer;
const footerLinks = copy.footerLinks.map((link) => ({ ...link, href: getStudioNavigationPath(link.href, locale) }));
const legalLinks = copy.legalLinks.map((link) => ({ ...link, href: getStudioNavigationPath(link.href, locale) }));
const socialLinks = getEnabledSocialLinks(company);
---

<footer id="footer-cta" style="background-image: url('/assets/images/stackcraftstudio/stackcraftstudio-cta-mountains@1920.webp')" class="relative overflow-hidden rounded-t-[var(--rounded-lg)] bg-brand-dark bg-cover bg-center bg-no-repeat text-brand-light">
  <div class="absolute inset-0 bg-brand-dark/65" aria-hidden="true"></div>
  <div class="ui-container relative z-10 mx-auto grid w-[min(100%-2rem,80rem)] gap-10 py-16 pb-8 sm:py-20">
    <div class="mx-auto max-w-5xl text-center">
      <p class="mb-4 flex items-center justify-center gap-4 text-xs font-bold uppercase tracking-[0.14em] text-brand-accent">
        <span class="h-px w-10 bg-brand-accent/70" aria-hidden="true"></span>
        <span>{copy.eyebrow}</span>
        <span class="h-px w-10 bg-brand-accent/70" aria-hidden="true"></span>
      </p>
      <h2 class="m-0 max-w-none text-[clamp(2.5rem,7vw,5.5rem)] leading-[0.95] tracking-[-0.06em] text-brand-light lg:whitespace-nowrap">{copy.heading}</h2>
      <p class="mx-auto mt-6 max-w-xl text-[clamp(1rem,1.5vw,1.2rem)] leading-[1.55] text-brand-light/80">{copy.description}</p>
      <div class="mx-auto mt-10 flex w-full max-w-xs flex-col justify-center gap-3 sm:mt-12 sm:max-w-none sm:flex-row">
        <Button href={getStudioNavigationPath(copy.primaryHref, locale)} variant="accent" class="min-h-11 w-full sm:w-auto">{copy.primaryLabel}</Button>
        <Button href={getStudioNavigationPath(copy.secondaryHref, locale)} variant="outline" class="min-h-11 w-full !border-brand-light/65 !bg-brand-dark/35 !text-brand-light sm:w-auto">{copy.secondaryLabel}</Button>
      </div>
    </div>

    <div class="flex flex-col items-center gap-8 text-center sm:flex-row sm:items-center sm:justify-between sm:text-left">
      <div class="flex flex-wrap items-center justify-center gap-6 sm:justify-start">
        <nav aria-label={copy.ariaLegal} class="flex flex-wrap justify-center gap-x-6 gap-y-3 sm:justify-start">
          {legalLinks.map((link) => <a href={link.href} class="inline-flex min-h-11 items-center text-sm text-brand-light/80 transition-colors hover:text-brand-accent sm:min-h-0">{link.label}</a>)}
        </nav>
        {socialLinks.length > 0 && (
          <div class="flex items-center gap-3">
            {socialLinks.map((social) => (
              <a
                href={social.href}
                target="_blank"
                rel="noopener noreferrer"
                aria-label={social.label}
                class="inline-flex size-9 items-center justify-center rounded-full border border-brand-light/25 text-brand-light/85 transition-colors hover:border-brand-accent hover:text-brand-accent"
              >
                <i class={`ph ${social.icon} text-base`} aria-hidden="true"></i>
              </a>
            ))}
          </div>
        )}
      </div>

      <nav aria-label={copy.ariaNavigation} class="grid w-full grid-cols-2 gap-x-6 gap-y-3 sm:flex sm:w-auto sm:flex-wrap sm:justify-start lg:justify-end">
        {footerLinks.map((link) => <a href={link.href} class="inline-flex min-h-11 items-center text-sm text-brand-light transition-colors hover:text-brand-accent sm:min-h-0">{link.label}</a>)}
      </nav>
    </div>

    <div class="flex flex-col items-center gap-4 border-t border-brand-light/25 pt-8 text-center text-brand-light/75 sm:flex-row sm:items-center sm:justify-between sm:text-left">
      <Text tag="span" variant="feature-body-sm">
        {copy.copyright}
      </Text>
      <Text tag="span" variant="feature-body-sm" class="sm:text-right">
        {copy.attributionText}
      </Text>
    </div>
  </div>
</footer>
