---
import Section from "@components/ui/layout/Section.astro";
import Container from "@components/ui/layout/Container.astro";
import Heading from "@components/ui/atoms/Heading.astro";
import Text from "@components/ui/atoms/Text.astro";
import SmartImage from "@components/ui/atoms/SmartImage.astro";
import Icon from "@components/ui/atoms/Icon.astro";
import jsonData from "@data/sections/stackcraftstudio-projects.json";
import { ACTIVE_TEMPLATE } from "@config/template";

type Project = {
  category: string;
  title: string;
  description?: string;
  href?: string;
  image: string;
  alt: string;
};

interface Props {
  id?: string;
  title?: string;
  description?: string;
  linkLabel?: string;
  linkHref?: string;
  items?: Project[];
  class?: string;
}

const props = Astro.props as Props;
const fallback = ACTIVE_TEMPLATE === "stackcraftstudio" ? undefined : jsonData;
const title = props.title ?? fallback?.title;
const description = props.description ?? fallback?.description;
const linkLabel = props.linkLabel ?? fallback?.linkLabel;
const linkHref = props.linkHref ?? fallback?.linkHref ?? "#contact";
const items = props.items ?? fallback?.items ?? [];
---

<Section id={props.id ?? "work"} tone="page" class:list={["relative z-[1] -mt-4 rounded-t-[var(--rounded-lg)] pb-16", props.class]}>
  <Container class="w-full max-w-none px-[clamp(1.5rem,5vw,5rem)]">
    <div class="projects-intro">
      <div>
        <Heading tag="h2" variant="section-title">{title}</Heading>
      </div>
      <div>
        <Text variant="lead">{description}</Text>
        <a class="projects-link group" href={linkHref}>
          <Text tag="span" variant="body" class="transition-transform duration-300 ease-out group-hover:-translate-x-1 motion-reduce:transition-none">{linkLabel}</Text>
          <span class="inline-flex size-5 items-center justify-center leading-none transition-transform duration-300 ease-out group-hover:translate-x-1 motion-reduce:transition-none" aria-hidden="true">→</span>
        </a>
      </div>
    </div>

    <div class="projects-grid">
      {items.map((item) => {
        const cardHref = item.href || linkHref;
        const isExternal = /^https?:\/\//i.test(cardHref);
        return (
          <a
            class="project-card__link group"
            href={cardHref}
            target={isExternal ? "_blank" : undefined}
            rel={isExternal ? "noopener noreferrer" : undefined}
          >
            <article class="project-card">
              <figure>
                <SmartImage src={item.image} alt={item.alt} width={1024} height={445} loading="lazy" class="transition-transform duration-[1200ms] ease-out group-hover:scale-[1.02] motion-reduce:transition-none" />
              </figure>
              <div class="project-card__overlay">
                <div class="project-card__meta">
                  <span class="project-card__category">{item.category}</span>
                  <Heading tag="h3" variant="feature-title" class="project-card__title">{item.title}</Heading>
                  {item.description && (
                    <p class="project-card__description">{item.description}</p>
                  )}
                </div>
                <span class="project-card__arrow overflow-hidden" aria-hidden="true">
                  <span class="relative flex size-5 items-center justify-center leading-none">
                    <Icon name="arrow-up-right" class="absolute inset-0 flex items-center justify-center leading-none transition-transform duration-300 ease-out group-hover:translate-x-[140%] group-hover:-translate-y-[140%] motion-reduce:transition-none" />
                    <Icon name="arrow-up-right" class="absolute inset-0 flex items-center justify-center leading-none -translate-x-[140%] translate-y-[140%] transition-transform duration-300 ease-out group-hover:translate-x-0 group-hover:translate-y-0 motion-reduce:transition-none" />
                  </span>
                </span>
              </div>
            </article>
          </a>
        );
      })}
    </div>
  </Container>
</Section>

<style>
  .projects-intro {
    display: grid;
    gap: 1.5rem;
  }

  .projects-intro > div:first-child {
    min-width: 0;
  }

  .projects-intro > div:last-child {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 1rem;
    min-width: 0;
  }

  .projects-intro :global(.ui-type-section-title) {
    max-width: 37rem;
  }

  .projects-link {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    color: var(--color-brand-dark);
    text-decoration: none;
  }

  .projects-link:hover,
  .projects-link:focus-visible {
    color: var(--color-brand-accent);
  }

  .projects-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
    margin-top: 2rem;
  }

  .project-card {
    display: flex;
    flex-direction: column;
    height: 100%;
    min-width: 0;
    overflow: hidden;
    border: 1px solid var(--color-outline-variant);
    border-radius: var(--ui-radius-lg);
    background: var(--color-brand-dark);
    box-shadow: var(--ui-elevation-soft);
  }

  .project-card__link {
    display: block;
    height: 100%;
    color: inherit;
    text-decoration: none;
  }

  .project-card__link:focus-visible {
    outline: 2px solid var(--color-brand-accent);
    outline-offset: 3px;
    border-radius: var(--ui-radius-lg);
  }

  .project-card figure {
    position: relative;
    display: grid;
    aspect-ratio: 2.25 / 1;
    margin: 0;
    overflow: hidden;
    place-items: center;
    background: var(--color-surface-container-low);
  }

  .project-card figure :global(picture),
  .project-card figure :global(img) {
    display: block;
    width: 100%;
    height: 100%;
  }

  .project-card figure :global(img) {
    object-fit: cover;
    object-position: top center;
  }

  .project-card__overlay {
    display: flex;
    flex: 1 1 auto;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 1.25rem 1.35rem 1.35rem;
    background: var(--color-brand-dark);
    color: var(--color-surface);
  }

  .project-card__meta {
    min-width: 0;
    flex: 1 1 auto;
    text-align: left;
  }

  .project-card__category {
    display: inline-block;
    margin-bottom: 0.35rem;
    font-family: var(--font-sans);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-brand-accent);
  }

  .project-card__title {
    margin: 0;
    color: inherit;
    text-align: left;
  }

  .project-card__description {
    margin: 0.4rem 0 0;
    max-width: 34rem;
    font-family: var(--font-sans);
    font-size: 0.875rem;
    line-height: 1.45;
    color: rgb(255 253 249 / 0.84);
  }

  .project-card__arrow {
    display: grid;
    flex: 0 0 auto;
    width: 2.75rem;
    height: 2.75rem;
    place-items: center;
    border: 1px solid rgb(255 255 255 / 0.45);
    border-radius: 999px;
    background: var(--color-brand-accent);
    color: var(--color-brand-dark);
    font-family: var(--font-sans);
    font-size: 1.1rem;
    line-height: 1;
  }

  @media (min-width: 48rem) {
    .projects-intro {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      gap: 2.75rem;
    }

    .projects-intro > div:last-child {
      align-self: end;
      align-items: flex-end;
      justify-content: flex-end;
      text-align: right;
    }

    .projects-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 1.5rem;
      align-items: stretch;
    }

    .project-card figure {
      aspect-ratio: 2.25 / 1;
    }
  }
</style>
